# Copy to .env.local for local server development, or set in the verified
# GhostJob Vercel preview environment. Never put secrets in the tracked .env.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
# Public connection settings for server-side account verification. Copy the
# current VITE_SUPABASE_PUBLISHABLE_KEY value from .env without surrounding quotes.
SUPABASE_URL=https://auevehneizminspolipf.supabase.co
SUPABASE_ANON_KEY=
# Same random 32-byte (64 hex character) secret in Vercel Preview and Lovable Cloud.
# This signs server-to-server storage requests. Never VITE_; never share in chat.
# Lovable Cloud keeps its built-in service-role key inside the Edge Function.
GHOSTJOB_STORAGE_BRIDGE_SECRET=
GHOSTJOB_V3_ENABLED=false
GHOSTJOB_V3_SCHEMA_READY=false
GHOSTJOB_V3_ROLLOUT=pilot
GHOSTJOB_V3_PILOT_USERS=
GHOSTJOB_OPENAI_INVESTIGATION_ENABLED=false
GHOSTJOB_INVESTIGATION_SCHEMA_READY=false
GHOSTJOB_JEV_EVALUATION_ENABLED=false
