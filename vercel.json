{
  "rewrites": [
    {
      "source": "/featured",
      "destination": "/featured/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/scan.ts": {
      "maxDuration": 45
    },
    "api/storage-check.ts": {
      "maxDuration": 15
    }
  }
}
